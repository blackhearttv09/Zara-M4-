[Unit]
Description=M4 Five OS Autonomous Core Supervisor & IPC Bus
After=network.target local-fs.target systemd-sysctl.service
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/lib/m4five
ExecStart=/usr/bin/node /usr/lib/m4five/server.js
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=m4-core
LimitNOFILE=65536
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SYS_PTRACE CAP_DAC_OVERRIDE
ProtectSystem=strict
ReadWritePaths=/var/lib/m4five /tmp /var/log/m4five

[Install]
WantedBy=multi-user.target
